# ═══════════════════════════════════════════════════════════════════════════════
# AI PR Review Pipeline — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this to .env and fill in real values

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://codereview:codereview@postgres:5432/codereview

# ── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ── GitHub App ───────────────────────────────────────────────────────────────
GITHUB_APP_ID=your-app-id
GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nyour-key-here\n-----END RSA PRIVATE KEY-----
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# ── Service URLs (docker-compose internal networking) ────────────────────────
WEBHOOK_SERVICE_URL=http://webhook:8001
ORCHESTRATOR_URL=http://orchestrator:8002
REVIEWER_URL=http://reviewer:8003
LEARNER_URL=http://learner:8004

# ── Langfuse (optional) ─────────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-your-key
LANGFUSE_SECRET_KEY=sk-lf-your-key
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Misc ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
DEBUG=false
